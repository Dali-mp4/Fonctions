# Copy this to api/.env; keep it PRIVATE and out of GitHub.
# This is the Supabase URL and publishable key used in web/.env.local.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Server-side only: legacy service_role JWT for the restricted finish RPC.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
# Enable the sandbox endpoint only after Modal auth and SQL migration 004.
ENABLE_DRAFT_RUNNER=false
# When enabling sandbox tests, inject these as PRIVATE Render environment variables.
# Generate credentials in Modal; NEVER commit actual token values.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Keep ENABLE_DRAFT_RUNNER=false until Modal + Supabase server credentials are set.
# SUPABASE_SERVICE_ROLE_KEY must be a legacy service_role JWT for this API's
# Authorization: Bearer header (not an sb_secret_ API key).

# Opt in ONLY after applying migration 008; requires signed-in students.
ENABLE_PUBLIC_METHOD_RUNNER=false

# Exact HTTPS address of the Vercel website (without trailing slash).
# Example: https://your-project.vercel.app
WEB_APP_ORIGIN=
