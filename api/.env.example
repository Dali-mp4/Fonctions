# Copy this to api/.env; keep it PRIVATE and out of GitHub.
# This is the Supabase URL and publishable key used in web/.env.local.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Server-side only: legacy service_role JWT for the restricted finish RPC.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
# Enable the sandbox endpoint only after Modal auth and SQL migration 004.
ENABLE_DRAFT_RUNNER=false
# Modal SDK credentials come from `modal token new` on the API host.
