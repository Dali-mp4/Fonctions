# No keys needed for the public catalog UI. Start the FastAPI server locally.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Required for real login and contributor drafts:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only AI translation configuration. Do not prefix the key with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-4.1-mini
